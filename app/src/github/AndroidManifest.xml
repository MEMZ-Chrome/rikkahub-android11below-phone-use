<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- 工作区挂载共享存储目录需要「所有文件访问权限」；Play 对这个权限审核很严，只在 github 渠道声明 -->
  <uses-permission
    android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
    tools:ignore="ScopedStorage" />

  <!-- Android 11 以下 Phone Use 用录屏取帧代替无障碍截图 -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

  <application>
    <!-- Phone Use：只在 github 渠道声明，Play 不允许用无障碍服务做自动化 -->
    <service
      android:name=".phoneuse.PhoneUseAccessibilityService"
      android:exported="true"
      android:label="@string/phone_use_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/phone_use_accessibility" />
    </service>

    <!-- 录屏取帧：只在用户手动开启时运行，系统会在状态栏显示录屏提示 -->
    <service
      android:name=".phoneuse.PhoneScreenCaptureService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
  </application>

</manifest>
